OPENAI_API_KEY=sk-...
# Set to 1 to run without an API key (fake but realistic responses, for frontend work)
REHEARSAL_MOCK=0
# Models: the live classroom loop needs to be fast; swap STUDENT_MODEL/DIRECTOR_MODEL if latency is too high
ANALYST_MODEL=gpt-5.5
DIRECTOR_MODEL=gpt-5.4-mini
STUDENT_MODEL=gpt-5.4-mini
COACH_MODEL=gpt-5.5
