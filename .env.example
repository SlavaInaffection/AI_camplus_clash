OPENAI_API_KEY=sk-...
# Set to 1 to run without an API key (fake but realistic responses, for frontend work)
REHEARSAL_MOCK=0
# Live loop: Director writes student lines. Set LIVE_STUDENT_AGENTS=1 for a slower second LLM pass.
LIVE_STUDENT_AGENTS=0
# Models: keep director on a fast mini model — it runs every chunk
ANALYST_MODEL=gpt-4.1
DIRECTOR_MODEL=gpt-4.1-mini
STUDENT_MODEL=gpt-4.1-mini
COACH_MODEL=gpt-4.1
ANALYST_EFFORT=
DIRECTOR_EFFORT=
STUDENT_EFFORT=
COACH_EFFORT=
